# Copy to /srv/mlbops/env/mlbops.env on the VPS.
# Keep this file private on the server; do not commit real secrets.

POSTGRES_DB=mlbops
POSTGRES_USER=mlbops
POSTGRES_PASSWORD=change-me-long-random-password

MLBOPS_DB_BACKEND=postgres
MLBOPS_RUNTIME=vps
MLBOPS_APP_PASSWORD_SHA256=
MLBOPS_SESSION_SECRET=
MLBOPS_TWEET_MAX_CHARS=10000
MLBOPS_ALLOW_INTEL_RUN=1

# API/script keys used by existing functionality.
ANTHROPIC_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
