FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    MPLBACKEND=Agg

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      fonts-dejavu-core \
      fonts-liberation \
      git \
      libfreetype6 \
      libjpeg62-turbo \
      libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt mlbops/api/requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY . .

EXPOSE 8000
WORKDIR /app/mlbops
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
