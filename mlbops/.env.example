# Copy to .env and adjust. FastAPI loads mlbops/.env on startup (values here override
# shell-inherited env vars like MLB_WAREHOUSE_DIR so a stale export in ~/.zshrc does not win).
# morning_intel/morning_intel.py also loads this file (see load_dotenv in that script).

# ── Warehouse (files on disk) ───────────────────────────────────────────────
# Local dev default: {repo_root}/data/warehouse/mlb.
# VPS production default in docker-compose: /data/warehouse/mlb mounted from /srv/mlbops/warehouse/mlb.
# Google Drive is not part of the live runtime path in the VPS-first model.
# MLB_WAREHOUSE_DIR="/full/path/to/warehouse/mlb"
#
# Do NOT leave a tutorial placeholder here (e.g. /path/to/your/mlb/warehouse) — the API will
# look only on that path and leaderboards will fail even after rclone sync to data/warehouse/mlb.

# ── Control plane storage ───────────────────────────────────────────────────
# Current default is local SQLite at data/hub.db. VPS production uses Postgres.
# MLBOPS_DB_BACKEND=sqlite
# MLBOPS_DB_BACKEND=postgres
# DATABASE_URL=postgresql://mlbops:password@postgres:5432/mlbops
# MLBOPS_RUNTIME=vps
# MLBOPS_OUTPUTS_DIR=/outputs

# Hub dev port when not using default 3000. Matches start_hub.sh; also adds CORS origins in FastAPI.
# MLBOPS_HUB_PORT=3001

# Secure personal travel mode. Use ./scripts/start_mlbops_travel.sh plus:
#   tailscale serve --bg 3000
# Do not use Tailscale Funnel for this app.
# MLBOPS_LOCAL_ONLY=1
# MLBOPS_HUB_HOST=127.0.0.1
# MLBOPS_API_HOST=127.0.0.1

# App-level lock screen for the hub. Required before travel.
# Prefer the SHA-256 variant so the plaintext password is not stored in .env:
#   printf '%s' 'your-password' | shasum -a 256
# MLBOPS_APP_PASSWORD_SHA256=
# Fallback for local-only development:
# MLBOPS_APP_PASSWORD=
# Generate with: openssl rand -base64 48
# MLBOPS_SESSION_SECRET=

# Set to 1 to use only explicit CORS origins (no localhost:any-port regex). Optional for locked-down deploys.
# MLBOPS_STRICT_CORS=1

# Allow POST /intel/run from the hub (Regenerate snapshot). Use 0 in untrusted environments.
MLBOPS_ALLOW_INTEL_RUN=1

# Queue tweet length cap (X Premium long posts). FastAPI cards/queue/redraft use this.
# Optional: set the same in the Hub environment so PATCH /api/queue/.../tweet-text matches.
# MLBOPS_TWEET_MAX_CHARS=10000
# Optional: max JSON context chars for Queue “Redraft” (card snapshots, meta). Default 16000.
# MLBOPS_REDRAFT_META_MAX_CHARS=16000
# Queue redraft: short-first band for pitcher_card (Claude + Grok). Default 220-320.
# MLBOPS_REDRAFT_PITCHER_TWEET_MIN=220
# MLBOPS_REDRAFT_PITCHER_TWEET_MAX=320
# MLBOPS_REDRAFT_BATTER_TWEET_MIN=220
# MLBOPS_REDRAFT_BATTER_TWEET_MAX=320
# Max completion tokens per redraft (default 200).
# MLBOPS_REDRAFT_MAX_TOKENS=320

# X / Twitter — Queue “Post to X” (Next hub `lib/twitter.ts`, OAuth 1.0a user context).
# Developer Portal → Project → Keys; Access token must be generated with Read and Write.
# start_hub.sh sources this file so the hub process sees these vars.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# Optional: metrics on posted tweets (Bearer v2 read)
# TWITTER_BEARER_TOKEN=

# Claude (Anthropic) — Queue "Redraft" in the hub, tweet drafts in morning intel, etc.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override (default claude-sonnet-4-6)
# ANTHROPIC_MODEL=
